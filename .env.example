# ---------------------------------------------------------------------------
# Silo Breaker — environment configuration
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Authentication (Better Auth) -------------------------------------------
# Homepage URL of the deployed (or local) app, and a >=32 char secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin of the app (only needed if served from a different origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) ---------------------------------------------------------
# Serverless Postgres with pgvector. Leave unset to run in local mode, where
# the deep persistent vector memory is kept in data/local-memory.json.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Compute & AI inference (Nebius Token Factory / AI Cloud) ----------------
# Enables NVIDIA Nemotron reasoning for the Silo-Breaker Synthesis skill and
# real semantic embeddings (Qwen/Qwen3-Embedding-8B requested at 1536 dims).
# Without a key the app still works using deterministic local embeddings and
# template insight copy — ideal for offline development.
# NEBIUS_API_KEY=
# NEBIUS_CHAT_URL=https://api.tokenfactory.nebius.com/v1/chat/completions
# NEBIUS_CHAT_MODEL=nvidia/Nemotron-3_5-Lightning
# NEBIUS_EMBEDDINGS_URL=https://api.tokenfactory.nebius.com/v1/embeddings
# NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# --- Always-on background engine (workspace watcher) -------------------------
# Shared secret for POST /api/agent/ingest, plus the owner e-mail whose private
# graph receives the watched files.
# SILO_ENGINE_TOKEN=replace-with-another-long-random-secret
# SILO_OWNER_EMAIL=you@example.com
# SILO_WATCH_DIR=./samples/workspace
# SILO_APP_URL=http://localhost:3000
# SILO_POLL_SECONDS=15
